# 로컬 개발용 환경 변수 예시. 복사해서 .env 로 사용합니다.
# 운영 값(비밀번호, 키)은 절대 이 파일에 적지 않습니다.

NODE_ENV=development

# PostgreSQL
POSTGRES_USER=drm
POSTGRES_PASSWORD=drm_local_only
POSTGRES_DB=drm
POSTGRES_PORT=55432
DATABASE_URL=postgresql://drm:drm_local_only@localhost:55432/drm?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:56379
REDIS_PORT=56379

# SMTP (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=51025
MAILPIT_UI_PORT=58025
MAIL_FROM="DRM <no-reply@drm.local>"
