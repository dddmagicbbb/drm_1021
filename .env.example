# 로컬 개발용 환경 변수 예시. 복사해서 .env 로 사용합니다.
# 운영 값(비밀번호, 키)은 절대 이 파일에 적지 않습니다.
# Windows Docker Desktop은 localhost(::1) 포워딩이 실패할 수 있어 127.0.0.1을 사용합니다.

NODE_ENV=development

# PostgreSQL
POSTGRES_USER=drm
POSTGRES_PASSWORD=drm_local_only
POSTGRES_DB=drm
POSTGRES_PORT=55432
DATABASE_URL=postgresql://drm:drm_local_only@127.0.0.1:55432/drm?schema=public

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:56379
REDIS_PORT=56379

# SMTP (Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAILPIT_UI_PORT=58025
MAILPIT_API_URL=http://127.0.0.1:58025
MAIL_FROM="DRM <no-reply@drm.local>"

# 서버 인증 (로컬 개발용 값. 운영에서는 32자 이상 무작위 값을 비밀 저장소로 주입)
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
# 수신자 OTP 해시용 비밀값 (32자 이상)
OTP_PEPPER=local-dev-otp-pepper-change-me-0123456789
