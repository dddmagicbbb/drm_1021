{
  "name": "@drm/viewer-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DRM 보안 문서 뷰어",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
